{
  "name": "apidoct",
  "version": "0.3.0",
  "description": "Set up coding agents to use an ApiDoct gateway",
  "license": "MIT",
  "keywords": [
    "apidoct",
    "llm",
    "openai-compatible",
    "claude-code",
    "codex",
    "aider",
    "cline",
    "coding-agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "apidoct": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/config-files.js",
    "dist/config-files.d.ts",
    "dist/tools.js",
    "dist/tools.d.ts",
    "dist/types.js",
    "dist/types.d.ts",
    "tools.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "~6.0.2",
    "vitest": "^3.1.3"
  }
}
